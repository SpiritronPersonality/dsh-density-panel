{
  "name": "@local/density-panel",
  "version": "0.31.0",
  "private": true,
  "type": "module",
  "description": "Quality-first entry compression for DSH tool results: structured summaries for logs/JSON/diff, full originals archived, on-demand recall, per-window ledger. Tables, prose and code are not compressed by default.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/**",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "tools/**",
    "test/**",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "context",
    "compression",
    "tokens",
    "recall"
  ]
}
